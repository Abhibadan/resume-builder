# Server Configuration
PORT=3000
NODE_ENV=development

# Resume Template Storage
# Path to the directory where custom presets and templates are stored
RESUME_TEMPLATE_DIR=.resume-templates

# Playwright / Chromium Configuration
# Optional: Override the Chromium executable path (e.g., /usr/bin/google-chrome or /opt/google/chrome/chrome)
# RESUME_CHROMIUM_EXECUTABLE_PATH=

# Optional: Shared cache directory for Playwright browser binaries
# PLAYWRIGHT_BROWSERS_PATH=

